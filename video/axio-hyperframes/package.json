    "stills:v2:website": "node scripts/render-v2-stills.mjs website",
    "stills:v2:wechat": "node scripts/render-v2-stills.mjs wechat",
    "verify:renders:v2": "node scripts/verify-v2-renders.mjs",
    "capture:v2": "node scripts/capture-evidence.mjs"
  },
